# Copia este archivo a .env.local y rellena los valores. NUNCA subas .env.local.
# En Vercel: Settings -> Environment Variables (mismos nombres).

# Públicas (llegan al navegador). La anon key es pública a propósito: RLS separa los datos.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor. Nunca con prefijo NEXT_PUBLIC. Sin clave, la app usa un borrador SIMULADO.
GEMINI_API_KEY=
# Nombre del modelo Flash gratuito vigente en Google AI Studio.
GEMINI_MODEL=

# Aleatorio, 32+ caracteres. Vercel Cron lo manda como "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Opcional. La app usa el host de la petición; esto solo lo fuerza. P. ej. https://sello-gamma.vercel.app
NEXT_PUBLIC_SITE_URL=

# No existe SUPABASE_SERVICE_ROLE_KEY a propósito: la app nunca la usa.
